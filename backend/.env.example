DATABASE_URL=postgresql+asyncpg://avto:avto@127.0.0.1:5433/avto
TEST_DATABASE_URL=postgresql+asyncpg://avto:avto@127.0.0.1:5433/avto_test
# Comma-separated frontend origins; http://localhost:5173 is always allowed. "*" is rejected.
CORS_ORIGINS=
# Enabled suppliers, comma-separated
SUPPLIERS=rossko
# Rossko: keys — личный кабинет Росско; доставка и адрес — из GetCheckoutDetails
ROSSKO_KEY1=
ROSSKO_KEY2=
# 000000001 = самовывоз (без адреса); курьер — 000000002 и id адреса
ROSSKO_DELIVERY_ID=000000001
ROSSKO_ADDRESS_ID=
# Mikado (add "mikado" to SUPPLIERS to enable): client number and password from the Mikado account.
# Requests only from the registered server IP; MIKADO_FAKE=true serves test fixtures without network (dev only)
MIKADO_CLIENT_ID=
MIKADO_PASSWORD=
MIKADO_FAKE=false
# Interactive API docs and /openapi.json; keep false in production. Local development sets true (needed by npm run gen:api)
API_DOCS=false
