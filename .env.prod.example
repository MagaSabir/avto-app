# Production env: copy to .env on the server, fill in the values, never commit .env
# Postgres container
POSTGRES_USER=avto
# Random, 32+ characters; must match the password in DATABASE_URL
POSTGRES_PASSWORD=
POSTGRES_DB=avto
DATABASE_URL=postgresql+asyncpg://avto:change-me@db:5432/avto
# Frontend origin only; "*" is rejected
CORS_ORIGINS=https://rossmik.ru
SUPPLIERS=rossko
# Rossko keys: pasted by the owner on the server
ROSSKO_KEY1=
ROSSKO_KEY2=
# 000000001 = pickup (no address)
ROSSKO_DELIVERY_ID=000000001
ROSSKO_ADDRESS_ID=
# Keep false in production
API_DOCS=false
